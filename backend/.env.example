# Georgia Foreclosure Platform — backend .env.example
# Copy to .env (gitignored). NEVER commit real values.
# Service-role key + direct DB URL are SERVER-SIDE ONLY. Never expose to frontend.

# Supabase (supplied project — do not create a new project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER-SIDE ONLY — never in NEXT_PUBLIC_* or frontend code:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[password]@db.<ref>.supabase.co:5432/postgres

# Backend
FASTAPI_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
INGESTION_SECRET=change-me-to-a-long-random-secret
# Optional
SENTRY_DSN=
LOG_LEVEL=INFO
# Ingestion tuning
INGESTION_PAGE_DELAY_SECONDS=1.5
INGESTION_MAX_PAGES=50
INGESTION_TIMEOUT_SECONDS=30
