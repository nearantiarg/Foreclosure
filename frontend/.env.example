# Public (safe to expose in browser) — anon key only, RLS enforced.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI backend base URL (public endpoint, no secrets).
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000
# Server-only (NEVER prefix with NEXT_PUBLIC_, NEVER commit real values).
# Used only by app/api/admin/ingestion/route.ts on the server.
INGESTION_SECRET=

# Server-only admin gate for /admin + /api/admin/ingestion (see route.ts). Leave unset for local dev only; set in production.
ADMIN_TOKEN=
