# Georgia Foreclosure Platform — environment template
# Copy to .env.local (frontend/backend local dev) and NEVER commit real values.
# .env / .env.local are gitignored. All values below are EMPTY on purpose.
# Get real values from the SUPPLIED Supabase project + deployment settings.

# --- Supabase (cloud project supplied by owner) ---
# Public project URL. Also used as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
# Anon / publishable key. Safe for browser use with RLS. Also used as NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
# SERVER-ONLY. NEVER expose in client bundles, NEXT_PUBLIC_* vars, logs, or frontend code.
# Used only by FastAPI backend, Next.js Server Components / Route Handlers, and CI secrets.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER-ONLY direct Postgres connection string (for migrations / supabase db push).
# Used only server-side / CLI. Never in browser code.
SUPABASE_DB_URL=

# --- Frontend (Next.js) — browser-safe, RLS-enforced ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL of the deployed FastAPI backend (for browser-safe analytics calls via Next.js).
NEXT_PUBLIC_FASTAPI_BASE_URL=

# --- Backend (FastAPI) ---
# Base URL the backend listens on / is deployed at (e.g. http://localhost:8000 in dev).
FASTAPI_BASE_URL=
# Secret protecting POST /ingestion/run. Must match the INGESTION_SECRET GitHub secret
# used by .github/workflows/ingestion.yml. Never expose to the browser.
INGESTION_SECRET=

# --- Optional ---
# Sentry DSN for error reporting (optional; leave empty to disable).
SENTRY_DSN=
# Log level for backend (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=
# Node env for frontend (development | production).
NODE_ENV=

# Server-only admin gate for Next.js admin routes
ADMIN_TOKEN=
